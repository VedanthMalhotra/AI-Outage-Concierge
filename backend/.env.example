# Copy to .env and adjust. All values have sensible defaults in config.py.

# S3 location of the cleaned data
AEP_S3_BUCKET=sagemaker-aep-outage-indiansassemble
AEP_S3_PREFIX=processed

# AWS auth: the named profile created during Agent Toolkit setup.
# (SSO session must be active: run `aws sso login --sso-session osu-sandbox`)
AWS_PROFILE=default
AWS_REGION=us-east-2

# Optional: point at a local directory of parquet files instead of S3.
# If set, the loader reads from here (useful offline / for faster dev).
# AEP_LOCAL_DATA_DIR=C:/path/to/aep_processed

# CORS origins allowed to call the API (comma-separated). "*" allows all.
AEP_CORS_ORIGINS=*
